      await setBrandPhoto(up.url);
      toast('Photo de marque mise à jour 🖼️', 'ok');
    } catch (e) {
      toast('Échec : ' + e.message, 'err');
    }
  });
}

async function setBrandPhoto(url) {
  const r = await api('adminSetBrandPhoto', { url });
  if (r.success) { BRAND_PHOTO = url; renderBrandPhoto(); }
  else toast(r.error || 'Erreur', 'err');
}

