async function saveFabric() {
  const id = document.getElementById('f-id').value;
  const name = document.getElementById('f-name').value.trim();
  if (!name) { toast('Le nom est obligatoire.', 'err'); return; }

  let image = '';
  const existing = FABRICS.find(x => String(x.id) === String(id));
  if (removeFabricImg) {
    image = '';
  } else if (pendingFabricImage) {
    setSaveBusy('save-fabric-btn', true);
    toast('Envoi de la photo sur Google Drive…');
    try {
      const up = await api('adminUploadImage', { dataUrl: pendingFabricImage });
      setSaveBusy('save-fabric-btn', false);
      if (!up.success) throw new Error(up.error);
      image = up.url;
    } catch (e) {
      setSaveBusy('save-fabric-btn', false);
      toast('Échec de l\'upload photo : ' + e.message, 'err');
      return;
    }
  } else {
    const urlVal = document.getElementById('f-url-input').value.trim();
    image = urlVal || (existing ? existing.image : '');
  }

  // ancienne photo retirée/remplacée → à supprimer du Drive
  const deleteImages = [];
  if (existing && existing.image && existing.image !== image) deleteImages.push(existing.image);
  const fabric = {
    id, name,
    cat: document.getElementById('f-cat').value.trim(),
    desc: document.getElementById('f-desc').value.trim(),
    image,
    active: document.getElementById('f-active').checked
  };

  // ── Mise à jour optimiste de l'interface ──
  const isNew = !id;
  const tempId = isNew ? 'tmp-' + Date.now() : id;
  const optimisticItem = {
    id: tempId, name: fabric.name, cat: fabric.cat,
    desc: fabric.desc, image: fabric.image, active: fabric.active
  };
  const li = FABRICS.findIndex(x => String(x.id) === String(id));
  const origIdx = li;
  if (li >= 0) FABRICS[li] = optimisticItem; else FABRICS.push(optimisticItem);
  closeFabricModal();
  renderFabrics(); renderStats();

  try {
    const r = await api('adminSaveFabric', { fabric, deleteImages });
    if (r && r.success) {
      const ti = FABRICS.findIndex(x => String(x.id) === String(tempId));
      if (ti >= 0) FABRICS[ti].id = r.id;
      renderFabrics(); renderStats();
      toast(id ? 'Tissu mis à jour ✅' : 'Tissu ajouté 🎉', 'ok');
    } else {
      await reconcileFabrics(tempId, existing, isNew, origIdx, optimisticItem, (r && r.error) || 'Erreur');
    }
  } catch (e) {
    await reconcileFabrics(tempId, existing, isNew, origIdx, optimisticItem, 'Erreur serveur : ' + e.message);
  }
}

function rollbackFabric(tempId, existing, isNew, origIdx) {
  const ri = FABRICS.findIndex(x => String(x.id) === String(tempId));
  if (ri >= 0) FABRICS.splice(ri, 1);
  if (!isNew && existing) FABRICS.splice(Math.min(origIdx || 0, FABRICS.length), 0, existing);
  renderFabrics(); renderStats();
}

// Resynchronise la liste des tissus avec la vérité du backend.
async function reconcileFabrics(tempId, existing, isNew, origIdx, optimisticItem, errMsg) {
  try {
    const f = await fetchJson('getFabrics');
    FABRICS = f.fabrics || [];
    BRAND_PHOTO = f.brandPhoto || BRAND_PHOTO;
    renderFabrics(); renderStats(); renderBrandPhoto();
    const t = optimisticItem || {};
    let saved = false;
    if (existing) {
      // Édition : on retrouve le tissu par son ID et on compare les champs modifiables
      const fresh = FABRICS.find(x => String(x.id) === String(existing.id));
      saved = !!(fresh &&
        String(fresh.name || '').trim().toLowerCase() === String(t.name || '').trim().toLowerCase() &&
        String(fresh.desc || '').trim() === String(t.desc || '').trim());
    } else {
      // Création : l'ID serveur est inconnu → on matche par nom
      const n = String(t.name || '').trim().toLowerCase();
      saved = !!n && FABRICS.some(x => String(x.name || '').trim().toLowerCase() === n);
    }
    toast(saved ? 'Enregistrement confirmé par le serveur ✅' : errMsg, saved ? 'ok' : 'err');
  } catch (e2) {
    rollbackFabric(tempId, existing, isNew, origIdx);
    toast(errMsg, 'err');
  }
}
// Suggestions de tissus existants dans le champ produit
function suggestFabrics() {
  const wrap = document.getElementById('p-fabric-chips');
  const existing = [...new Set(FABRICS.map(f => f.name).filter(Boolean))];
  wrap.innerHTML = existing.map(n => `<button class="chip" onclick="addFabricChip('${escAttr(n)}')">+ ${esc(n)}</button>`).join('');
}

function addFabricChip(name) {
  const input = document.getElementById('p-fabrics');
  const vals = input.value.split(',').map(s => s.trim()).filter(Boolean);
  if (!vals.includes(name)) {
    vals.push(name);
    input.value = vals.join(', ');
  }
}

// ══════════ COMMANDES ══════════
function buildOrderFilters() {
  const statuses = ['A traiter', 'Traiter', 'En cours', 'Expédiée', 'Livrée', 'Annulée'];
  const wrap = document.getElementById('order-filters');
  wrap.innerHTML = `<button class="chip active" onclick="setStatusFilter('')">Toutes</button>` +
    statuses.map(s => `<button class="chip" onclick="setStatusFilter('${escAttr(s)}')">${esc(s)}</button>`).join('');
}

function setStatusFilter(s) {
  activeStatusFilter = s;
  document.querySelectorAll('#order-filters .chip').forEach(b => b.classList.toggle('active', b.textContent === (s || 'Toutes')));
  renderOrders();
}

function badgeClass(statut) {
  const s = String(statut || '').trim().toLowerCase();
  if (s === 'a traiter') return 'b-a';
  if (s === 'traiter') return 'b-t';
  if (s === 'en cours') return 'b-c';
  if (s === 'expédiée') return 'b-e';
  if (s === 'livrée') return 'b-l';
  return 'b-x';
}

function toDateInput(d) {
  if (!d) return '';
  if (d instanceof Date && !isNaN(d)) {
    return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
  }
  const m = String(d).match(/^(d{4})-(d{2})-(d{2})/);
  return m ? String(d).slice(0, 10) : String(d);
}

function fmtDate(d) {
  if (!d) return '';
  const dt = new Date(d);
  if (isNaN(dt)) return String(d);
  return dt.toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' }) +
    ' ' + dt.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
}

function renderOrders() {
  const q = (document.getElementById('order-search').value || '').toLowerCase();
  const filtered = ORDERS.filter(o =>
    (!activeStatusFilter || String(o.statut || '').trim().toLowerCase() === activeStatusFilter.toLowerCase()) &&
    (!q || String(o.name || '').toLowerCase().includes(q) ||
          String(o.id || '').toLowerCase().includes(q) ||
          String(o.phone || '').toLowerCase().includes(q))
  );
  const list = document.getElementById('orders-list');
  if (!filtered.length) {
    list.innerHTML = `<div class="empty-state"><div class="e-ico">🛒</div><p>Aucune commande trouvée.</p></div>`;
    return;
  }
  list.innerHTML = filtered.map(o => `
    <div class="order-item" id="oi-${escAttr(o.id)}">
      <div class="order-head" onclick="openOrderModal('${escAttr(o.id)}')">
        <div class="order-ref">${esc(o.id)}</div>
        <div class="order-meta">
          <div class="nm">${esc(o.name || 'Client')}</div>
          <div class="dt">${fmtDate(o.date)} · 📞 ${esc(o.phone || '—')}</div>
        </div>
        <span class="badge ${badgeClass(o.statut)}">${esc(o.statut || 'A traiter')}</span>
        <div class="order-total">${o.total !== undefined && o.total !== '' ? Number(o.total).toFixed(2) + ' €' : '—'}</div>
      </div>
    </div>`).join('');
}

function openOrderModal(id) {
  const o = ORDERS.find(x => String(x.id) === String(id));
  if (!o) return;
  document.getElementById('om-ref').textContent = 'Commande ' + o.id;
  document.getElementById('om-client').textContent = 'Gestion de la commande';
  document.getElementById('om-name').textContent = o.name || '—';
  document.getElementById('om-phone').textContent = '📞 ' + (o.phone || '—');
  document.getElementById('om-email').textContent = '✉️ ' + (o.email || '—');
  document.getElementById('om-date').textContent = '🕐 Reçue le ' + fmtDate(o.date);
  document.getElementById('om-articles').textContent = o.articles || '—';
  document.getElementById('om-total').textContent = 'Total : ' + (o.total !== undefined && o.total !== '' ? Number(o.total).toFixed(2) + ' €' : '—');
  const promo = (o.promoCode ? '🎁 Code : ' + o.promoCode + (o.promoReduction ? ' (−' + o.promoReduction + '%)' : '') : '');
  document.getElementById('om-promo').textContent = promo;
  document.getElementById('om-note').textContent = o.note || 'Aucune remarque';
  document.getElementById('om-statut').value = o.statut || 'A traiter';
  document.getElementById('om-date-proposee').value = toDateInput(o.dateProposee);
  document.getElementById('om-prix-demande').value = o.prixDemande !== undefined && o.prixDemande !== '' ? o.prixDemande : '';
  document.getElementById('om-remarques').value = o.note || '';
  document.getElementById('om-date-souhaitee').textContent = o.dateSouhaitee || 'Non précisée';
  document.getElementById('order-modal').classList.add('active');
}

function closeOrderModal() {
  document.getElementById('order-modal').classList.remove('active');
}

async function saveOrderChanges() {
  const o = ORDERS.find(x => String(x.id) === String(document.getElementById('om-ref').textContent.replace('Commande ', '')));
  if (!o) return;
  const order = {
    id: o.id,
    statut: document.getElementById('om-statut').value,
    dateProposee: document.getElementById('om-date-proposee').value,
    prixDemande: document.getElementById('om-prix-demande').value,
    remarques: document.getElementById('om-remarques').value
  };
  // ── Mise à jour optimiste de l'interface ──
  const prev = JSON.parse(JSON.stringify(o));
  o.statut = order.statut;
  o.dateProposee = order.dateProposee;
  o.prixDemande = order.prixDemande;
  o.note = order.remarques;
  closeOrderModal();
  renderOrders(); renderStats(); renderDashOrders();
  try {
    const r = await api('adminUpdateOrder', { order });
    if (r && r.success) {
      toast(r.emailSent ? 'Commande mise à jour ✅ Email envoyé à la cliente ✉️' : 'Commande mise à jour ✅', 'ok');
    } else {
      await reconcileOrders(o, prev, (r && r.error) || 'Erreur');
    }
  } catch (e) {
    await reconcileOrders(o, prev, 'Erreur serveur : ' + e.message);
  }
}

// Resynchronise les commandes avec la vérité du backend : si la commande a bien été
// mise à jour malgré une réponse d'erreur, l'affichage optimiste reste.
async function reconcileOrders(o, prev, errMsg) {
  try {
    const fresh = await fetchJson('getOrders');
    const orders = Array.isArray(fresh) ? fresh : (fresh && fresh.orders) || [];
    ORDERS = orders;
    renderOrders(); renderStats(); renderDashOrders();
    // Comparaison ciblée et sûre : le statut et le prix (la date peut avoir des formats
    // différents entre le formulaire et la feuille → on évite un faux négatif qui ferait
    // re-disparaître la carte à tort).
    const normStatut = s => String(s || '').toLowerCase().replace(/\s+/g, ' ').trim();
    const normPrix = s => String(s || '').replace(/[\s\u00A0]/g, '').replace(',', '.');
    const saved = orders.some(x =>
      String(x.id) === String(o.id) &&
      normStatut(x.statut) === normStatut(o.statut) &&
      (normPrix(x.prixDemande) === normPrix(o.prixDemande) || Number(normPrix(x.prixDemande)) === Number(normPrix(o.prixDemande)))
    );
    toast(saved ? 'Enregistrement confirmé par le serveur ✅' : errMsg, saved ? 'ok' : 'err');
  } catch (e2) {
    Object.assign(o, prev);
    renderOrders(); renderStats(); renderDashOrders();
    toast(errMsg, 'err');
  }
}
// ══════════ TABLEAU DE BORD ══════════
function renderDashOrders() {
  const list = document.getElementById('dash-orders');
  const recent = ORDERS.slice().sort((a, b) => new Date(b.date) - new Date(a.date)).slice(0, 5);
  if (!recent.length) {
    list.innerHTML = `<div class="empty-state"><div class="e-ico">🛒</div><p>Pas encore de commande.</p></div>`;
    return;
  }
  list.innerHTML = recent.map(o => `
    <div class="order-item">
      <div class="order-head" onclick="showView('commandes')">
        <div class="order-ref">${esc(o.id)}</div>
        <div class="order-meta">
          <div class="nm">${esc(o.name || 'Client')}</div>
          <div class="dt">${fmtDate(o.date)}</div>
        </div>
        <span class="badge ${badgeClass(o.statut)}">${esc(o.statut || 'A traiter')}</span>
        <div class="order-total">${o.total !== undefined && o.total !== '' ? Number(o.total).toFixed(2) + ' €' : '—'}</div>
      </div>
    </div>`).join('');
}

// ══════════ CONFIRMATION SUPPRESSION ══════════
function askDelete(kind, id, name) {
  document.getElementById('confirm-title').textContent = 'Supprimer « ' + name + ' » ?';
  document.getElementById('confirm-text').textContent =
    kind === 'produit' ? 'La création disparaîtra de la boutique.' : 'Le tissu disparaîtra de la page Tissus.';
  confirmCb = async () => {
    const action = kind === 'produit' ? 'adminDeleteProduct' : 'adminDeleteFabric';
    const list = kind === 'produit' ? PRODUCTS : FABRICS;
    const idx = list.findIndex(x => String(x.id) === String(id));
    const removed = idx >= 0 ? list.splice(idx, 1)[0] : null;
    closeConfirm();
    renderProducts(); renderFabrics(); renderStats(); buildFilters(); fillCatDatalist();
    try {
      const r = await api(action, { id });
      if (r.success) {
        toast('Supprimé ✅', 'ok');
      } else {
        if (removed) list.splice(Math.min(idx, list.length), 0, removed);
        renderProducts(); renderFabrics(); renderStats(); buildFilters(); fillCatDatalist();
        toast(r.error || 'Erreur', 'err');
      }
    } catch (e) {
      if (removed) list.splice(Math.min(idx, list.length), 0, removed);
      renderProducts(); renderFabrics(); renderStats(); buildFilters(); fillCatDatalist();
      toast('Erreur : ' + e.message, 'err');
    }
  };
  document.getElementById('confirm-modal').classList.add('active');
}
function confirmAction() { if (confirmCb) confirmCb(); }
function closeConfirm() {
  confirmCb = null;
  document.getElementById('confirm-modal').classList.remove('active');
}

// ══════════ RÉGLAGES ══════════
async function changePassword() {
  const oldPwd = document.getElementById('pw-old').value;
  const newPwd = document.getElementById('pw-new').value;
  const confirm = document.getElementById('pw-confirm').value;
  if (!oldPwd || !newPwd) { toast('Remplissez tous les champs.', 'err'); return; }
  if (newPwd !== confirm) { toast('Les mots de passe ne correspondent pas.', 'err'); return; }
  if (newPwd.length < 8) { toast('Minimum 8 caractères.', 'err'); return; }
  try {
    const r = await api('adminChangePassword', { oldPassword: oldPwd, newPassword: newPwd });
    if (r.success) {
      toast('Mot de passe modifié ✅', 'ok');
      document.getElementById('pw-old').value = '';
      document.getElementById('pw-new').value = '';
      document.getElementById('pw-confirm').value = '';
    } else toast(r.error || 'Erreur', 'err');
  } catch (e) {
    toast('Erreur serveur : ' + e.message, 'err');
  }
}

// ══════════ IMAGE : compression & utilitaires ══════════
function compressImage(file, cb) {
  const reader = new FileReader();
  reader.onload = e => {
    const img = new Image();
    img.onload = () => {
      const maxDim = 1400;
      let { width: w, height: h } = img;
      if (Math.max(w, h) > maxDim) {
        const r = maxDim / Math.max(w, h);
        w = Math.round(w * r);
        h = Math.round(h * r);
      }
      const canvas = document.createElement('canvas');
      canvas.width = w;
      canvas.height = h;
      canvas.getContext('2d').drawImage(img, 0, 0, w, h);
      cb(canvas.toDataURL('image/jpeg', 0.82));
    };
    img.src = e.target.result;
  };
  reader.readAsDataURL(file);
}

function esc(s) {
  return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}
function escAttr(s) {
  return esc(s).replace(/'/g, '&#39;');
}

