<script>
// ══════════════════════════════════════════════════════════════
//  CONFIG — URL de la web app Apps Script (identique à la boutique)
// ══════════════════════════════════════════════════════════════
const GAS_URL = "https://script.google.com/macros/s/AKfycbzC2zM9G4rgXWK5YyFpIw4b6xQDciw_FbMvZ3Sq_oefyeXOGTHBIh-xzUW-f4bc4NLw/exec";

let TOKEN = localStorage.getItem('dg_admin_token') || '';
let PRODUCTS = [];
let FABRICS = [];
let ORDERS = [];
let BRAND_PHOTO = '';
let activeCatFilter = '';
let activeStatusFilter = '';
let pendingImages = [null, null, null, null]; // dataUrls prêts à uploader (produit, jusqu'à 4)
let pendingFabricImage = null;
let removeImages = [false, false, false, false]; // l'utilisateur veut retirer chaque photo
let removeFabricImg = false;
let confirmCb = null;

// ── APPEL API (POST lisible : Content-Type text/plain = pas de preflight CORS) ──
async function api(action, data = {}) {
  const res = await fetch(GAS_URL, {
    method: 'POST',
    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
    body: JSON.stringify({ action, token: TOKEN, ...data })
  });
  return res.json();
}

// ── LECTURES PUBLIQUES (GET) ──
async function fetchJson(action) {
  const res = await fetch(GAS_URL + "?action=" + action);
  return res.json();
}

// ══════════ TOAST ══════════
let toastTimer = null;
function toast(msg, type = '') {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.className = 'show ' + type;
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.className = '', 3200);
}

// ══════════ CONNEXION ══════════
async function doLogin() {
  const pwd = document.getElementById('login-password').value;
  const btn = document.getElementById('login-btn');
  const err = document.getElementById('login-error');
  if (!pwd) { err.textContent = 'Veuillez saisir votre mot de passe.'; return; }
  btn.disabled = true; btn.textContent = 'Connexion…';
  err.textContent = '';
  try {
    const r = await api('adminLogin', { password: pwd });
    if (r.success && r.token) {
      TOKEN = r.token;
      localStorage.setItem('dg_admin_token', r.token);
      enterApp();
    } else {
      err.textContent = r.error || 'Mot de passe incorrect.';
    }
  } catch (e) {
    err.textContent = 'Impossible de joindre le serveur. Vérifiez votre connexion.';
  }
  btn.disabled = false; btn.textContent = 'Se connecter';
}

function doLogout() {
  if (TOKEN) api('adminLogout').catch(() => {});
  TOKEN = '';
  localStorage.removeItem('dg_admin_token');
  location.reload();
}

function enterApp() {
  document.getElementById('login-screen').classList.add('hidden');
  document.getElementById('app').classList.remove('hidden');
  refreshAll();
}

// ══════════ NAVIGATION ══════════
function showView(name) {
  document.querySelectorAll('.main section').forEach(s => s.classList.add('hidden'));
  document.getElementById('view-' + name).classList.remove('hidden');
  document.querySelectorAll('.nav-item').forEach(n => n.classList.toggle('active', n.dataset.view === name));
  if (name === 'produits') renderProducts();
  if (name === 'tissus') renderFabrics();
  if (name === 'commandes') renderOrders();
  if (name === 'dashboard') refreshAll();
}

// ══════════ CHARGEMENT ══════════
async function refreshAll() {
  try {
    const [p, f, o] = await Promise.all([
      fetchJson('getProducts'),
      fetchJson('getFabrics'),
      fetchJson('getOrders')
    ]);
    PRODUCTS = p.apps || [];
    FABRICS = f.fabrics || [];
    BRAND_PHOTO = f.brandPhoto || '';
    ORDERS = o || [];
    renderStats();
    renderProducts();
    renderFabrics();
    renderOrders();
    renderDashOrders();
    renderBrandPhoto();
    fillCatDatalist();
    buildFilters();
    buildOrderFilters();
  } catch (e) {
    toast('Erreur de chargement des données.', 'err');
  }
}

function renderStats() {
  const actifs = PRODUCTS.filter(p => p.active).length;
  const aTraiter = ORDERS.filter(o => { const st = String(o.statut || '').trim().toLowerCase(); return st === 'a traiter' || st === 'traiter'; }).length;
  document.getElementById('st-produits').textContent = actifs;
  document.getElementById('st-tissus').textContent = FABRICS.filter(f => f.active).length;
  document.getElementById('st-commandes').textContent = ORDERS.length;
  document.getElementById('st-a-traiter').textContent = aTraiter;
}

function fillCatDatalist() {
  const cats = [...new Set(PRODUCTS.map(p => p.cat).filter(Boolean))];
  document.getElementById('cat-list').innerHTML = cats.map(c => `<option value="${esc(c)}">`).join('');
}

// ══════════ CRÉATIONS ══════════
function buildFilters() {
  const cats = [...new Set(PRODUCTS.map(p => p.cat).filter(Boolean))];
  const wrap = document.getElementById('prod-filters');
  wrap.innerHTML = `<button class="chip active" onclick="setCatFilter('')">Tout</button>` +
    cats.map(c => `<button class="chip" onclick="setCatFilter('${escAttr(c)}')">${esc(c)}</button>`).join('');
}

function setCatFilter(cat) {
  activeCatFilter = cat;
  document.querySelectorAll('#prod-filters .chip').forEach(b => b.classList.toggle('active', b.textContent === (cat || 'Tout')));
  renderProducts();
}

function adminStockLabel(p) {
  if (p.stock === null || p.stock === undefined) return '';
  if (p.stock <= 0) return '<div style="font-size:11px;font-weight:600;letter-spacing:1px;text-transform:uppercase;color:var(--red);margin-bottom:10px;">❌ Rupture de stock</div>';
  if (p.stock <= 3) return '<div style="font-size:11px;font-weight:600;letter-spacing:1px;text-transform:uppercase;color:#b8860b;margin-bottom:10px;">⚠️ Plus que ' + p.stock + ' en stock</div>';
  return '<div style="font-size:11px;font-weight:500;letter-spacing:1px;text-transform:uppercase;color:var(--green);margin-bottom:10px;">✓ ' + p.stock + ' en stock</div>';
}
function renderProducts() {
  const q = (document.getElementById('prod-search').value || '').toLowerCase();
  const filtered = PRODUCTS.filter(p =>
    (!activeCatFilter || p.cat === activeCatFilter) &&
    (!q || p.name.toLowerCase().includes(q) || p.desc.toLowerCase().includes(q))
  );
  const grid = document.getElementById('products-grid');
  if (!filtered.length) {
    grid.innerHTML = `<div class="empty-state"><div class="e-ico">🌸</div><p>Aucune création pour le moment.<br>Cliquez sur « Nouvelle création » pour commencer.</p></div>`;
    return;
  }
  grid.innerHTML = filtered.map(p => `
    <div class="card ${p.active ? '' : 'off-card'}">
      <div class="card-img">
        ${p.image ? `<img src="${esc(imgSrc(p.image))}" alt="${esc(p.name)}" onerror="imgFail(this,'${esc(p.emoji || '🧵')}')">` : `<span class="emoji-ph">${esc(p.emoji || '🧵')}</span>`}
        ${(p.images && p.images.length > 1) ? '<span class="card-badge multi">📷 ' + p.images.length + '</span>' : ''}
        ${p.active ? (p.custom ? '<span class="card-badge">Tissu au choix</span>' : '') : '<span class="card-badge off">Masquée</span>'}
      </div>
      <div class="card-body">
        <div class="card-cat">${esc(p.cat || 'Création')}</div>
        <div class="card-name">${esc(p.name)}</div>
        <div class="card-desc">${esc(p.desc || '')}</div>
        <div class="card-price">${p.price} €</div>
        ${adminStockLabel(p)}
        <div class="toggle-row">
          <label class="switch"><input type="checkbox" ${p.active ? 'checked' : ''} onchange="toggleProduct('${escAttr(p.id)}', this.checked)"><span class="slider"></span></label>
          ${p.active ? 'En ligne' : 'Masquée'}
        </div>
        <div class="card-actions">
          <button class="btn btn-soft" onclick="openProductModal('${escAttr(p.id)}')">✏️ Modifier</button>
          <button class="btn btn-danger" onclick="askDelete('produit','${escAttr(p.id)}','${escAttr(p.name)}')">🗑</button>
        </div>
      </div>
    </div>`).join('');
}

function toggleProduct(id, active) {
  const p = PRODUCTS.find(x => String(x.id) === String(id));
  const prev = p ? p.active : null;
  if (p) {
    p.active = active;
    p.outOfStock = !active || (p.stock !== null && p.stock <= 0);
  }
  renderProducts();
  api('adminToggleProduct', { id, active }).then(r => {
    if (r.success) {
      toast(active ? 'Création remise en ligne ✨' : 'Création masquée du site', 'ok');
    } else {
      if (p && prev !== null) { p.active = prev; p.outOfStock = !prev || (p.stock !== null && p.stock <= 0); }
      renderProducts();
      toast(r.error || 'Erreur', 'err');
    }
  }).catch(() => {
    if (p && prev !== null) { p.active = prev; p.outOfStock = !prev || (p.stock !== null && p.stock <= 0); }
    renderProducts();
    toast('Erreur réseau, modification annulée', 'err');
  });
}
// ── MODAL PRODUIT ──
function openProductModal(id) {
  pendingImages = [null, null, null, null];
  removeImages = [false, false, false, false];
  setSaveBusy('save-product-btn', false);
  const m = document.getElementById('product-modal');
  document.getElementById('product-modal-title').textContent = id ? 'Modifier la création' : 'Nouvelle création';
  document.getElementById('p-id').value = id || '';
  const p = PRODUCTS.find(x => String(x.id) === String(id));
  document.getElementById('p-name').value = p ? p.name : '';
  document.getElementById('p-cat').value = p ? p.cat : '';
  document.getElementById('p-price').value = p ? p.price : '';
  document.getElementById('p-emoji').value = p ? p.emoji : '🧵';
  document.getElementById('p-stock').value = (p && p.stock !== null && p.stock !== undefined) ? p.stock : '';
  document.getElementById('p-desc').value = p ? p.desc : '';
  document.getElementById('p-custom').checked = p ? p.custom : false;
  document.getElementById('p-fabrics').value = p && p.fabrics ? p.fabrics.join(', ') : '';
  document.getElementById('p-active').checked = p ? p.active : true;
  document.getElementById('p-promo-active').checked = p ? p.promoActive : false;
  document.getElementById('p-promo-code').value = p ? (p.promoCode || '') : '';
  document.getElementById('p-promo-reduc').value = p ? (p.promoReduction || '') : '';
  document.getElementById('p-promo-min').value = p ? (p.promoMin || '') : '';
  const imgs = (p && p.images && p.images.length) ? p.images : (p && p.image ? [p.image] : []);
  for (let i = 0; i < 4; i++) {
    document.getElementById('p-url-input-' + i).value = '';
    document.getElementById('p-url-input-' + i).classList.add('hidden');
    setProductPreview(i, imgs[i] || '');
  }
  m.classList.add('active');
  suggestFabrics();
}

function closeProductModal() {
  document.getElementById('product-modal').classList.remove('active');
  pendingImages = [null, null, null, null];
  removeImages = [false, false, false, false];
}

function setProductPreview(i, url) {
  const box = document.getElementById('p-photo-preview-' + i);
  box.innerHTML = url ? `<img src="${esc(imgSrc(url))}" onerror="this.style.display='none'">` : '📷';
}

function handleProductFile(ev, i) {
  const file = ev.target.files[0];
  if (!file) return;
  compressImage(file, (dataUrl) => {
    removeImages[i] = false;
    pendingImages[i] = dataUrl;
    setProductPreview(i, dataUrl);
    toast('Photo ' + (i + 1) + ' prête — elle sera enregistrée sur Drive.', 'ok');
  });
  ev.target.value = '';
}

function clearProductImage(i) {
  removeImages[i] = true;
  pendingImages[i] = null;
  document.getElementById('p-url-input-' + i).value = '';
  document.getElementById('p-photo-file-' + i).value = '';
  setProductPreview(i, '');
}

// Convertit toute URL Google Drive en URL d'image directe (lh3 = sans redirection)
function imgSrc(url) {
  url = String(url || '').trim();
  if (!url) return '';
  let m = url.match(new RegExp('/file/d/([a-zA-Z0-9_-]+)'));
  if (m) return 'https://lh3.googleusercontent.com/d/' + m[1];
  m = url.match(/[?&]id=([a-zA-Z0-9_-]+)/);
  if (m) return 'https://lh3.googleusercontent.com/d/' + m[1];
  return url;
}
// Secours : si l'image ne charge pas, on affiche l'emoji à la place
function imgFail(img, emoji) {
  img.onerror = null;
  const ph = document.createElement('span');
  ph.className = 'emoji-ph';
  ph.textContent = emoji || img.dataset.emoji || '🧵';
  img.replaceWith(ph);
}

function setImageFromUrl(which, a, b) {
  if (which === 'p') {
    const i = a, url = b || '';
    pendingImages[i] = null;
    removeImages[i] = false;
    document.getElementById('p-photo-file-' + i).value = '';
    setProductPreview(i, url);
  } else if (which === 'f') {
    const url = a || '';
    pendingFabricImage = null;
    removeFabricImg = false;
    document.getElementById('f-photo-file').value = '';
    document.getElementById('f-photo-preview').innerHTML = url ? `<img src="${esc(imgSrc(url))}" onerror="this.style.display='none'">` : '📷';
  }
}

function toggleUrlInput(which, idx) {
  const el = document.getElementById(which === 'p' ? ('p-url-input-' + idx) : 'f-url-input');
  el.classList.toggle('hidden');
  if (!el.classList.contains('hidden')) el.focus();
}

function setSaveBusy(btnId, busy) {
  const btn = document.getElementById(btnId);
  if (!btn) return;
  if (busy) { btn.classList.add('busy'); btn.innerHTML = '<span class="spinner"></span>Enregistrement…'; }
  else { btn.classList.remove('busy'); btn.textContent = '💾 Enregistrer'; }
}

async function saveProduct() {
  const id = document.getElementById('p-id').value;
  const name = document.getElementById('p-name').value.trim();
  const price = parseFloat(document.getElementById('p-price').value);
  if (!name) { toast('Le nom est obligatoire.', 'err'); return; }
  if (isNaN(price) || price < 0) { toast('Indiquez un prix valide.', 'err'); return; }

  // 1) upload des photos (jusqu'à 4)
  const images = ['', '', '', ''];
  const existing = PRODUCTS.find(x => String(x.id) === String(id));
  const existingImgs = (existing && existing.images && existing.images.length)
    ? existing.images
    : (existing && existing.image ? [existing.image] : []);
  for (let i = 0; i < 4; i++) {
    if (removeImages[i]) { images[i] = ''; continue; }
    if (pendingImages[i]) {
      setSaveBusy('save-product-btn', true);
      toast('Envoi de la photo ' + (i + 1) + ' sur Google Drive…');
      try {
        const up = await api('adminUploadImage', { dataUrl: pendingImages[i] });
        if (!up.success) throw new Error(up.error);
        images[i] = up.url;
      } catch (e) {
        setSaveBusy('save-product-btn', false);
        toast('Échec de l\'upload photo : ' + e.message, 'err');
        return;
      }
    } else {
      const urlVal = document.getElementById('p-url-input-' + i).value.trim();
      images[i] = urlVal || (existingImgs[i] || '');
    }
  }
  setSaveBusy('save-product-btn', false);
  // photos retirées ou remplacées → à supprimer du Drive après sauvegarde
  const deleteImages = [];
  (existingImgs || []).forEach(u => {
    if (u && images.indexOf(u) === -1 && deleteImages.indexOf(u) === -1) deleteImages.push(u);
  });
  const product = {
    id, name, cat: document.getElementById('p-cat').value.trim(),
    price,
    emoji: document.getElementById('p-emoji').value.trim() || '🧵',
    stock: document.getElementById('p-stock').value.trim() === '' ? null : Math.max(0, parseInt(document.getElementById('p-stock').value, 10) || 0),
    desc: document.getElementById('p-desc').value.trim(),
    image: images[0] || '',
    images,
    custom: document.getElementById('p-custom').checked,
    fabrics: document.getElementById('p-fabrics').value.split(',').map(s => s.trim()).filter(Boolean),
    active: document.getElementById('p-active').checked,
    promoCode: document.getElementById('p-promo-code').value.trim().toUpperCase(),
    promoReduction: parseFloat(document.getElementById('p-promo-reduc').value) || 0,
    promoMin: parseFloat(document.getElementById('p-promo-min').value) || 0,
    promoActive: document.getElementById('p-promo-active').checked
  };

  // ── Mise à jour optimiste de l'interface ──
  const isNew = !id;
  const tempId = isNew ? 'tmp-' + Date.now() : id;
  const optimisticItem = {
    id: tempId, name: product.name, cat: product.cat, price: product.price,
    emoji: product.emoji, desc: product.desc, image: product.image, images: product.images,
    custom: product.custom, fabrics: product.fabrics, active: product.active,
    stock: product.stock,
    promoCode: product.promoCode, promoReduction: product.promoReduction,
    promoMin: product.promoMin, promoActive: product.promoActive,
    outOfStock: !product.active || (product.stock !== null && product.stock <= 0)
  };
  const li = PRODUCTS.findIndex(x => String(x.id) === String(id));
  const origIdx = li;
  if (li >= 0) PRODUCTS[li] = optimisticItem; else PRODUCTS.push(optimisticItem);
  closeProductModal();
  renderProducts(); renderStats(); buildFilters(); fillCatDatalist();

  try {
    const r = await api('adminSaveProduct', { product, deleteImages });
    if (r && r.success) {
      const ti = PRODUCTS.findIndex(x => String(x.id) === String(tempId));
      if (ti >= 0) PRODUCTS[ti].id = r.id;
      renderProducts(); renderStats(); buildFilters(); fillCatDatalist();
      toast(id ? 'Création mise à jour ✅' : 'Création ajoutée à la boutique 🎉', 'ok');
    } else {
      await reconcileProducts(tempId, existing, isNew, origIdx, optimisticItem, (r && r.error) || 'Erreur');
    }
  } catch (e) {
    await reconcileProducts(tempId, existing, isNew, origIdx, optimisticItem, 'Erreur serveur : ' + e.message);
  }
}

function rollbackProduct(tempId, existing, isNew, origIdx) {
  const ri = PRODUCTS.findIndex(x => String(x.id) === String(tempId));
  if (ri >= 0) PRODUCTS.splice(ri, 1);
  if (!isNew && existing) PRODUCTS.splice(Math.min(origIdx || 0, PRODUCTS.length), 0, existing);
  renderProducts(); renderStats(); buildFilters(); fillCatDatalist();
}

// Resynchronise la liste avec la vérité du backend : si la création/édition a bien été
// enregistrée malgré une réponse d'erreur, la carte optimiste reste affichée (avec son vrai ID).
async function reconcileProducts(tempId, existing, isNew, origIdx, optimisticItem, errMsg) {
  try {
    const p = await fetchJson('getProducts');
    PRODUCTS = p.apps || [];
    renderProducts(); renderStats(); buildFilters(); fillCatDatalist();
    const t = optimisticItem || {};
    let saved = false;
    if (existing) {
      // Édition : on retrouve l'item par son ID et on compare les champs modifiables
      const fresh = PRODUCTS.find(x => String(x.id) === String(existing.id));
      saved = !!(fresh &&
        String(fresh.name || '').trim().toLowerCase() === String(t.name || '').trim().toLowerCase() &&
        String(fresh.cat || '').trim().toLowerCase() === String(t.cat || '').trim().toLowerCase() &&
        (Number(fresh.price) || 0) === (Number(t.price) || 0) &&
        String(fresh.desc || '').trim() === String(t.desc || '').trim() &&
        !!fresh.active === !!t.active &&
        !!fresh.custom === !!t.custom &&
        (fresh.stock === t.stock || Number(fresh.stock) === Number(t.stock)));
    } else {
      // Création : l'ID serveur est inconnu → on matche par nom + prix
      const n = String(t.name || '').trim().toLowerCase();
      saved = !!n && PRODUCTS.some(x =>
        String(x.name || '').trim().toLowerCase() === n && (Number(x.price) || 0) === (Number(t.price) || 0));
    }
    toast(saved ? 'Enregistrement confirmé par le serveur ✅' : errMsg, saved ? 'ok' : 'err');
  } catch (e2) {
    rollbackProduct(tempId, existing, isNew, origIdx);
    toast(errMsg, 'err');
  }
}
// ══════════ TISSUS ══════════
function renderFabrics() {
  const q = (document.getElementById('fabric-search').value || '').toLowerCase();
  const filtered = FABRICS.filter(f => !q || f.name.toLowerCase().includes(q) || f.desc.toLowerCase().includes(q));
  const grid = document.getElementById('fabrics-grid');
  if (!filtered.length) {
    grid.innerHTML = `<div class="empty-state"><div class="e-ico">🧵</div><p>Aucun tissu pour le moment.<br>Cliquez sur « Nouveau tissu » pour en ajouter.</p></div>`;
    return;
  }
  grid.innerHTML = filtered.map(f => `
    <div class="card ${f.active ? '' : 'off-card'}">
      <div class="card-img">
        ${f.image ? `<img src="${esc(f.image)}" alt="${esc(f.name)}">` : '<span class="emoji-ph">🧵</span>'}
        ${!f.active ? '<span class="card-badge off">Indisponible</span>' : ''}
      </div>
      <div class="card-body">
        <div class="card-cat">${esc(f.cat || 'Tissu')}</div>
        <div class="card-name">${esc(f.name)}</div>
        <div class="card-desc">${esc(f.desc || '')}</div>
        <div class="toggle-row">
          <label class="switch"><input type="checkbox" ${f.active ? 'checked' : ''} onchange="toggleFabric('${escAttr(f.id)}', this.checked)"><span class="slider"></span></label>
          ${f.active ? 'Disponible' : 'Indisponible'}
        </div>
        <div class="card-actions">
          <button class="btn btn-soft" onclick="openFabricModal('${escAttr(f.id)}')">✏️ Modifier</button>
          <button class="btn btn-danger" onclick="askDelete('tissu','${escAttr(f.id)}','${escAttr(f.name)}')">🗑</button>
        </div>
      </div>
    </div>`).join('');
}

function toggleFabric(id, active) {
  const f = FABRICS.find(x => String(x.id) === String(id));
  const prev = f ? f.active : null;
  if (f) f.active = active;
  renderFabrics();
  api('adminToggleFabric', { id, active }).then(r => {
    if (r.success) {
      toast(active ? 'Tissu rendu disponible ✅' : 'Tissu marqué indisponible', 'ok');
    } else {
      if (f && prev !== null) f.active = prev;
      renderFabrics();
      toast(r.error || 'Erreur', 'err');
    }
  }).catch(() => {
    if (f && prev !== null) f.active = prev;
    renderFabrics();
    toast('Erreur réseau, modification annulée', 'err');
  });
}
function renderBrandPhoto() {
